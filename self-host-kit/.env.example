# Copy to .env and fill in. Never commit or share the real .env.

# Public hostname. Its DNS A record must already point to this server's IP.
N8N_FQDN=n8n.example.com

# Email for Let's Encrypt expiry notices.
SSL_EMAIL=you@example.com

# Timezone used by Cron / Schedule nodes (IANA name).
GENERIC_TIMEZONE=America/New_York

# Pinned n8n version. To update: change this, then `docker compose pull && docker compose up -d`.
N8N_VERSION=2.43.7

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate with: openssl rand -hex 32
# BACK THIS UP. Without it, every saved credential in n8n becomes unreadable.
N8N_ENCRYPTION_KEY=
